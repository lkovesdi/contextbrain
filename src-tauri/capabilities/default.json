{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for the main window. Deep-link + updater are added per-plugin; audio + filesystem will be scoped in later phases when those commands land.",
  "windows": ["main", "meeting-popup", "update-popup"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "updater:default",
    "allow-ping",
    "allow-start-meeting",
    "allow-dismiss-popup",
    "allow-dismiss-update-popup",
    "allow-restart-app",
    "allow-pending-update-version",
    "allow-pending-update-notes",
    "allow-capture-screenshot",
    "allow-capture-screen-recording",
    "allow-stop-screen-recording"
  ]
}
