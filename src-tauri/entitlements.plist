<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WebKit/getUserMedia microphone capture (and a future ScreenCaptureKit/AVAudioEngine sidecar). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required by the embedded WKWebView / JavaScriptCore JIT under hardened runtime.
         Don't remove: stripping it silently breaks the recorder in release builds. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Network access (Supabase, Deepgram, Anthropic, Composio). -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
